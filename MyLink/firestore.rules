rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    function linkFields(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 80
        && data.url is string && data.url.size() <= 2000 && data.url.matches('https?://.+');
    }
    match /usernames/{username} {
      allow get: if true;
      allow create: if request.auth != null && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && username.matches('[a-z0-9][a-z0-9-]{2,23}') && !(username in ['api', 'demo', 'login', 'mypage'])
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == username;
    }
    match /users/{uid} {
      allow get: if true;
      allow create: if owner(uid) && request.resource.data.keys().hasOnly(['username', 'name', 'bio'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
        && request.resource.data.bio is string && request.resource.data.bio.size() <= 200
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == uid;
      match /links/{id} {
        allow read, delete: if owner(uid);
        allow create: if owner(uid) && linkFields(request.resource.data)
          && request.resource.data.keys().hasOnly(['title', 'url', 'clickCount']) && request.resource.data.clickCount == 0;
        allow update: if owner(uid) && linkFields(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'url']);
      }
      match /publicLinks/{id} {
        allow read: if true;
        allow delete: if owner(uid);
        allow create, update: if owner(uid) && linkFields(request.resource.data)
          && request.resource.data.keys().hasOnly(['title', 'url']);
      }
    }
  }
}
